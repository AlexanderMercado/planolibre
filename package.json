{
  "name": "planolibre",
  "version": "0.1.0",
  "description": "Editor de planos 2D/3D de código abierto que funciona 100% local en el navegador, con línea de comandos y servidor MCP para agentes.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "bin": {
    "planolibre": "bin/planolibre.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:cli": "vite build --config vite.cli.config.ts",
    "prepare": "npm run build:cli"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
